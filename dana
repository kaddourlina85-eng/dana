@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Inter:wght@400;500;600;700&display=swap');

:root{
  --pink: #ffd3ea;
  --hotpink: #ff6fb0;
  --deeppink: #c81f6f;
  --ink: #1d1d1f;
  --ink-soft: #6e6e73;
  --bg: #fdfaf9;
  --card: #ffffff;
  --line: #eeeaea;
  --radius: 22px;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family:'Inter', -apple-system, sans-serif;
  background:var(--bg);
  color:var(--ink);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.display{
  font-family:'Fraunces', serif;
  font-weight:600;
  letter-spacing:-0.02em;
}
a{ color:inherit; text-decoration:none; }
img{ max-width:100%; display:block; border-radius:var(--radius); }

/* ---------- NAV ---------- */
.nav{
  position:sticky; top:0; z-index:50;
  display:flex; align-items:center; justify-content:space-between;
  padding:18px 5%;
  background:rgba(253,250,249,.8);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}
.nav .logo{ font-family:'Fraunces',serif; font-weight:700; font-size:1.1rem; color:var(--deeppink); }
.nav ul{ list-style:none; display:flex; gap:28px; flex-wrap:wrap; }
.nav ul a{
  font-size:.92rem; font-weight:500; color:var(--ink-soft);
  padding:6px 2px; border-bottom:2px solid transparent;
  transition:.2s;
}
.nav ul a:hover, .nav ul a.active{ color:var(--deeppink); border-color:var(--hotpink); }
.nav-toggle{ display:none; }

@media(max-width:760px){
  .nav ul{
    position:absolute; top:100%; left:0; right:0;
    background:var(--bg); flex-direction:column; gap:0;
    max-height:0; overflow:hidden; transition:max-height .3s ease;
    border-bottom:1px solid var(--line);
  }
  .nav ul.open{ max-height:400px; }
  .nav ul li{ padding:14px 5%; border-top:1px solid var(--line); }
  .nav-toggle{ display:block; background:none; border:none; font-size:1.4rem; cursor:pointer; color:var(--deeppink); }
}

/* ---------- HERO ---------- */
.hero{
  padding:90px 5% 60px;
  text-align:center;
  max-width:900px; margin:0 auto;
}
.eyebrow{
  display:inline-block; font-size:.8rem; letter-spacing:.14em; text-transform:uppercase;
  color:var(--deeppink); background:var(--pink); padding:6px 16px; border-radius:999px;
  margin-bottom:18px; font-weight:600;
}
.hero h1{ font-size:clamp(2.4rem,6vw,4.2rem); line-height:1.05; }
.hero p.lead{ font-size:1.15rem; color:var(--ink-soft); max-width:560px; margin:20px auto 0; }

.hero-image{
  width:220px; height:220px; border-radius:50%;
  margin:36px auto 0; overflow:hidden;
  border:6px solid #fff; box-shadow:0 20px 50px rgba(200,31,111,.18);
}
.hero-image img{ width:100%; height:100%; object-fit:cover; border-radius:0; }

/* ---------- SECTIONS / CARDS ---------- */
section{ padding:70px 5%; max-width:1000px; margin:0 auto; }
.section-title{ font-size:clamp(1.8rem,4vw,2.6rem); margin-bottom:12px; }
.section-sub{ color:var(--ink-soft); max-width:600px; margin-bottom:36px; }

.card{
  background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
  padding:32px; box-shadow:0 2px 20px rgba(0,0,0,.03);
}
.grid{ display:grid; gap:22px; }
.grid-2{ grid-template-columns:repeat(2,1fr); }
.grid-3{ grid-template-columns:repeat(3,1fr); }
@media(max-width:760px){ .grid-2,.grid-3{ grid-template-columns:1fr; } }

.quote{
  font-family:'Fraunces',serif; font-size:1.4rem; font-style:italic;
  color:var(--deeppink); border-left:3px solid var(--hotpink);
  padding-left:22px; margin:30px 0;
}

.chip{
  display:inline-block; background:var(--pink); color:var(--deeppink);
  font-weight:600; font-size:.85rem; padding:7px 16px; border-radius:999px;
  margin:4px 6px 4px 0;
}

/* reveal on scroll */
.reveal{ opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease; }
.reveal.in{ opacity:1; transform:translateY(0); }

/* ---------- FLIP PHONE ---------- */
.phone-wrap{ display:flex; justify-content:center; padding:40px 0; perspective:1200px; }
.flip-phone{
  width:220px; cursor:pointer;
}
.phone-body{
  background:linear-gradient(160deg,#ffe1f1,#ffb6dd);
  border-radius:20px; padding:16px; box-shadow:0 20px 40px rgba(200,31,111,.25);
  border:3px solid #fff;
}
.phone-screen{
  background:#fff5fa; border-radius:12px; height:160px;
  display:flex; align-items:center; justify-content:center; text-align:center;
  font-size:.85rem; color:var(--deeppink); font-weight:600; padding:14px;
  border:2px solid var(--pink);
}
.phone-lid{
  height:70px; background:linear-gradient(160deg,#ff9fce,#ff6fb0);
  border-radius:16px 16px 0 0; margin-bottom:-16px;
  transform-origin:bottom; transition:transform .6s ease;
  display:flex; align-items:center; justify-content:center;
  font-family:'Fraunces',serif; color:#fff; font-weight:700;
  border:3px solid #fff; border-bottom:none;
}
.flip-phone.open .phone-lid{ transform:rotateX(150deg); }
.phone-hint{ text-align:center; font-size:.8rem; color:var(--ink-soft); margin-top:10px; }

/* ---------- GALLERY ---------- */
.gallery{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }
.gallery figure{ margin:0; border-radius:18px; overflow:hidden; cursor:pointer; position:relative; }
.gallery img{ border-radius:0; aspect-ratio:1; object-fit:cover; transition:transform .4s ease; }
.gallery figure:hover img{ transform:scale(1.06); }
.gallery figcaption{
  position:absolute; bottom:0; left:0; right:0; padding:10px 14px;
  background:linear-gradient(0deg,rgba(0,0,0,.55),transparent);
  color:#fff; font-size:.8rem; font-weight:600;
}

/* lightbox */
.lightbox{
  position:fixed; inset:0; background:rgba(20,10,15,.85);
  display:none; align-items:center; justify-content:center; z-index:100; padding:20px;
}
.lightbox.open{ display:flex; }
.lightbox img{ max-width:90vw; max-height:85vh; border-radius:14px; }
.lightbox-close{
  position:absolute; top:24px; right:5%; color:#fff; font-size:2rem; cursor:pointer; background:none; border:none;
}

/* ---------- TAG CLOUD ---------- */
.cloud{ display:flex; flex-wrap:wrap; gap:12px; }
.cloud span{
  font-family:'Fraunces',serif; font-weight:600;
  padding:12px 20px; border-radius:999px; background:#fff;
  border:1.5px solid var(--pink); color:var(--deeppink);
  box-shadow:0 4px 0 rgba(255,182,221,.5);
  transition:transform .2s;
}
.cloud span:hover{ transform:rotate(-3deg) scale(1.05); }

/* ---------- TIMELINE ---------- */
.timeline{ border-left:2px solid var(--pink); padding-left:26px; }
.timeline .item{ position:relative; margin-bottom:34px; }
.timeline .item::before{
  content:''; position:absolute; left:-33px; top:4px;
  width:12px; height:12px; border-radius:50%; background:var(--hotpink);
  box-shadow:0 0 0 4px var(--pink);
}

footer{
  text-align:center; padding:50px 5%; color:var(--ink-soft); font-size:.85rem;
  border-top:1px solid var(--line); margin-top:40px;
}

// mobile nav toggle
document.querySelectorAll('.nav-toggle').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelector('.nav ul').classList.toggle('open');
  });
});

// scroll reveal
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver(entries=>{
  entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('in'); });
},{threshold:.15});
revealEls.forEach(el=>io.observe(el));

// flip phone
document.querySelectorAll('.flip-phone').forEach(phone=>{
  phone.addEventListener('click', ()=> phone.classList.toggle('open'));
});

// gallery lightbox
const lightbox = document.querySelector('.lightbox');
if(lightbox){
  const lightboxImg = lightbox.querySelector('img');
  document.querySelectorAll('.gallery img').forEach(img=>{
    img.addEventListener('click', ()=>{
      lightboxImg.src = img.src;
      lightbox.classList.add('open');
    });
  });
  lightbox.querySelector('.lightbox-close').addEventListener('click', ()=> lightbox.classList.remove('open'));
  lightbox.addEventListener('click', e=>{ if(e.target===lightbox) lightbox.classList.remove('open'); });
}
